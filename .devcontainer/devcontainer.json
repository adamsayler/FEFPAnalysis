{
  "name": "FEFPAnalysis",

  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "remoteUser": "vscode",

  "runArgs": [
    "--device=/dev/net/tun"
  ],

  "features": {
    "ghcr.io/tailscale/codespace/tailscale:1.0.8": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "containerEnv": {
    "PGHOST": "100.106.55.38",
    "PGPORT": "5432",
    "PGUSER": "adam",

    "MSSQLHOST": "100.106.55.38",
    "MSSQLPORT": "1433",
    "MSSQLUSER": "sa",
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "quarto.quarto",
        "marimo-team.vscode-marimo",
        "ms-ossdata.vscode-pgsql",
        "ms-mssql.mssql"
      ]
    }
  },

  "postCreateCommand": "uv sync && python --version && uv --version && psql --version && sqlcmd -? >/dev/null && echo 'sqlcmd installed' && quarto --version && uv run marimo --version && gh --version && tailscale version"
}
